generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_ROLE {
  ADMIN
  USER
}

enum USER_MEETING_STATUS {
  CREATED
  JOINED
  ENDED
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  name        String
  password    String?
  firebaseUid String?
  oauth       String?
  accessToken String?
  idToken     String?
  role        USER_ROLE     @default(USER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  meetings    UserMeeting[]
}

model Meeting {
  id           String        @id @default(uuid())
  googleId     String?
  userMeetings UserMeeting[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserMeeting {
  id            String              @id @default(uuid())
  userId        String
  meetingId     String
  status        USER_MEETING_STATUS @default(CREATED)
  meeting       Meeting             @relation(fields: [meetingId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  fileUrl       String?
  transcript    Json?
  summary       String?
  containerId   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  ContainerPort ContainerPort[]
}

model ContainerPort {
  id            String       @id @default(uuid())
  port          Int
  userMeetingId String?
  userMeeting   UserMeeting? @relation(fields: [userMeetingId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
